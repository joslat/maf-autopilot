# --- .NET build output ---
bin/
obj/
nupkg/
*.nupkg
*.snupkg
src/dist/                # release.yml output staging
TestResults/             # `dotnet test` output (per-project)
coverage/                # coverage reports
*.coverage
*.coveragexml

# --- User / IDE / editor ---
*.user
*.suo
.vs/
.idea/
*.swp
*.swo
*~

# --- Claude Code per-user state (NEVER commit) ---
# .claude/settings.json IS committed (team-wide).
# .claude/settings.local.json is per-developer overrides — never commit.
.claude/settings.local.json
.claude/cache/
# Harness-managed state (scheduled wakeups, locks). Local-only.
.claude/*.lock
.claude/scheduled_tasks/

# --- Python (CI helpers in .github/scripts/) ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Secrets / environment ---
# Catch the usual suspects. Anything matching these should NEVER be committed.
.env
.env.*
!.env.example                # template files are fine
*.pem
*.key
*.p12
*.pfx
secrets.json
secrets.yaml
appsettings.*.local.json

# --- Logs ---
*.log
logs/

# --- NuGet lock files ---
# F-27 fixup: git does not treat a trailing `# comment` on the same line as a
# pattern as a comment — only a line whose FIRST character is `#` is a
# comment. The previous single-line form (`!packages.lock.json  # explicitly
# opt-in via csproj`) was parsed as one literal pattern including the comment
# text, so it never actually matched "packages.lock.json" and this negation
# silently never took effect — every packages.lock.json in the repo has been
# gitignored despite this comment's stated intent. Comment now on its own
# line so the negation is a real, minimal pattern.
# Explicitly opt in: RestorePackagesWithLockFile is set in Directory.Build.props.
*.lock.json
!packages.lock.json

# --- OS noise ---
.DS_Store
Thumbs.db
desktop.ini

# --- Misc dev scratch ---
# `types.txt` at the repo root was a one-time dev reference dump from
# `dotnet-inspect lib ModelContextProtocol`. Removed from tracking; ignoring
# in case anyone regenerates it locally.
/types.txt
*.scratch.md
*.scratch.txt

# --- local-only research and scratch notes ---
# Findings, competitor analysis, exploration notes that aren't part of the
# shipped product. Kept out of git deliberately so this stays a personal
# scratchpad.
private/

.ai-review-entries.json
.ai-review-prompt.md
