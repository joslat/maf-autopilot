<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- File-level namespaces stay `MafSample.FraudClaims` (same as 1.3 sample);
         only the assembly name differs so the 2 samples don't collide on disk. -->
    <RootNamespace>MafSample.FraudClaims</RootNamespace>
    <AssemblyName>MafSample.FraudClaims12</AssemblyName>

    <!-- Standalone version-parity sample — NOT in maf-autopilot.sln. Pinned to
         MAF 1.2.0 (the version BEFORE the 1.3 obsoletion wave) to validate that
         the toolkit's detection works against an older MAF pin. The
         anti-patterns mirror the 1.3 sample's; the value-add is multi-version
         coverage, NOT additional registry-rule coverage (see README.md for the
         Phase T registry-chronology finding). -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>

    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS8618;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- MAF 1.2.0 — fixed pin. Compatibility-matrix dictates the matching
         Microsoft.Extensions.AI 10.3.0 + Azure.AI.OpenAI 2.6.0 for this MAF
         version. -->
    <PackageReference Include="Microsoft.Agents.AI" Version="1.2.0" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.2.0" />

    <!-- Backing chat client.
         Phase W.A finding: the compatibility-matrix listed "MEAI >= 10.3.0" for
         MAF 1.2.0, but Microsoft.Agents.AI 1.2.0 actually has a transitive pin
         to `>= 10.5.0`. Likewise Azure.AI.OpenAI 2.6.0 was never published —
         lowest stable on NuGet is 2.7.0. Real minimums:
           Microsoft.Extensions.AI 10.5.0
           Azure.AI.OpenAI 2.7.0
         (See README.md → "Phase W.A compat-matrix correction".) -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.5.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.5.0" />
    <PackageReference Include="Azure.AI.OpenAI" Version="2.8.0-beta.1" />

    <!-- Identity package — required for the DefaultAzureCredential anti-pattern. -->
    <PackageReference Include="Azure.Identity" Version="1.13.1" />

    <!-- Security: transitive pin (GHSA-g94r-2vxg-569j). -->
    <PackageReference Include="OpenTelemetry.Api" Version="1.15.3" />
  </ItemGroup>

</Project>
