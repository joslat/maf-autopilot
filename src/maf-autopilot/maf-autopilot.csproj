<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Multi-target: NuGet picks the best TFM at install time. Matches the
         AgentEval house style (see docs/architecture.md → "Multi-targeting"). -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>MafAutopilot</RootNamespace>
    <AssemblyName>maf-autopilot</AssemblyName>

    <!-- .NET Global Tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>maf-autopilot</ToolCommandName>
    <PackageId>maf-autopilot</PackageId>
    <!-- Version policy: csproj <Version> = latest version on nuget.org.
         When cutting a new alpha, bump this AND push the workflow_dispatch
         on `release.yml`. Don't bump locally without pushing — the README
         documents the NuGet version, so any drift confuses users.
         (See plan #A.7 — version-drift fix landed 2026-05-12.) -->
    <Version>1.3.0-alpha-3</Version>
    <Authors>joslat</Authors>
    <Description>MAF autopilot MCP server — Tools + Resources + Prompts + Sampling for MAF 1.3.0 migrations. Answers "is this API safe?", exposes migration guide as resources, and uses sampling for multi-step agentic analysis.</Description>
    <PackageTags>maf;migration;mcp;dotnet;agents</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/joslat/maf-autopilot</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Ensure logs go to stderr so stdout stays clean for MCP protocol -->
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="maf-autopilot.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Versions pinned centrally in /Directory.Packages.props (CPM). -->
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Bundle registry.yaml as an embedded resource so the tool works as a standalone NuGet global tool.
      At runtime, RegistryService first checks MAF_REGISTRY_PATH env var (for local dev override),
      then falls back to this embedded resource.
    -->    <!-- README for NuGet package page -->
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <EmbeddedResource Include="..\..\.github\skills\obsolete-api-registry\registry.yaml"
                      LogicalName="registry.yaml" />

    <!-- MAF hard constraints — the non-negotiable rules, served at maf://constraints -->
    <EmbeddedResource Include="..\..\.github\instructions\maf-constraints.instructions.md"
                      LogicalName="constraints.md" />

    <!-- Full migration guide — served at maf://guide -->
    <EmbeddedResource Include="..\..\guides\maf-1.3.0-migration-guide.md"
                      LogicalName="guide.md" />

    <!-- All 13 skill SKILL.md files — served at maf://skills?name=<skill-name> -->
    <EmbeddedResource Include="..\..\.github\skills\cs0618-hunter\SKILL.md"
                      LogicalName="skills/cs0618-hunter.md" />
    <EmbeddedResource Include="..\..\.github\skills\dotnet-inspect\SKILL.md"
                      LogicalName="skills/dotnet-inspect.md" />
    <EmbeddedResource Include="..\..\.github\skills\fan-in-static-analyzer\SKILL.md"
                      LogicalName="skills/fan-in-static-analyzer.md" />
    <EmbeddedResource Include="..\..\.github\skills\fan-out-validator\SKILL.md"
                      LogicalName="skills/fan-out-validator.md" />
    <EmbeddedResource Include="..\..\.github\skills\maf-anti-pattern-scanner\SKILL.md"
                      LogicalName="skills/maf-anti-pattern-scanner.md" />
    <EmbeddedResource Include="..\..\.github\skills\maf-migration-guide\SKILL.md"
                      LogicalName="skills/maf-migration-guide.md" />
    <EmbeddedResource Include="..\..\.github\skills\maf-release-watcher\SKILL.md"
                      LogicalName="skills/maf-release-watcher.md" />
    <EmbeddedResource Include="..\..\.github\skills\migration-plan-creator\SKILL.md"
                      LogicalName="skills/migration-plan-creator.md" />
    <EmbeddedResource Include="..\..\.github\skills\migration-retrospective\SKILL.md"
                      LogicalName="skills/migration-retrospective.md" />
    <EmbeddedResource Include="..\..\.github\skills\nuget-diff-analyzer\SKILL.md"
                      LogicalName="skills/nuget-diff-analyzer.md" />
    <EmbeddedResource Include="..\..\.github\skills\obsolete-api-registry\SKILL.md"
                      LogicalName="skills/obsolete-api-registry.md" />
    <EmbeddedResource Include="..\..\.github\skills\workflow-smoke-tester\SKILL.md"
                      LogicalName="skills/workflow-smoke-tester.md" />
    <EmbeddedResource Include="..\..\.github\skills\maf-issue-reporter\SKILL.md"
                      LogicalName="skills/maf-issue-reporter.md" />
  </ItemGroup>

</Project>
